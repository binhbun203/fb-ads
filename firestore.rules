rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function activeAdmin() {
      return signedIn() && adminDoc().data.active == true;
    }

    function manager() {
      return activeAdmin() && adminDoc().data.role in ['owner', 'admin'];
    }

    function owner() {
      return activeAdmin() && adminDoc().data.role == 'owner';
    }

    match /admins/{uid} {
      allow read: if activeAdmin();
      allow create: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.active == true
        && exists(/databases/$(database)/documents/adminInvites/$(request.auth.token.email))
        && request.resource.data.role == get(/databases/$(database)/documents/adminInvites/$(request.auth.token.email)).data.role;
      allow update: if owner()
        && resource.data.role != 'owner'
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /adminInvites/{email} {
      allow read: if manager() || (signedIn() && request.auth.token.email == email);
      allow create, update: if manager()
        && request.resource.data.email == email
        && request.resource.data.role in ['admin', 'viewer'];
      allow delete: if manager() || (signedIn() && request.auth.token.email == email);
    }

    match /{document=**} {
      allow read, write: if activeAdmin();
    }
  }
}
